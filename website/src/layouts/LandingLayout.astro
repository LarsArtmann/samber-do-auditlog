---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/config';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteConfig.description} />
    <title>{title}</title>
    <meta property="og:title" content={siteConfig.name} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.siteUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={`${siteConfig.siteUrl}/images/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="do-auditlog HTML report — services table with lifecycle waveform, type badges, and dependency columns" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteConfig.name} />
    <meta name="twitter:description" content={siteConfig.description} />
    <meta name="twitter:image" content={`${siteConfig.siteUrl}/images/og-image.jpg`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={siteConfig.siteUrl} />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#e8a838" />
    <script is:inline src="/js/theme-init.js"></script>
  </head>
  <body class="font-sans bg-bg-primary text-text-secondary antialiased leading-relaxed">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent focus:text-bg-primary focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold">Skip to content</a>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": "do-auditlog demo — 25 seconds",
      "description": "Your DI container is a black box. do-auditlog wires full lifecycle telemetry into samber/do v2 in one line — real terminal output, the exported HTML report, and the install command.",
      "thumbnailUrl": [`${siteConfig.siteUrl}/images/demo-poster.jpg`],
      "uploadDate": "2026-09-01",
      "contentUrl": `${siteConfig.siteUrl}/demo.mp4`,
      "duration": "PT25S",
      "embedUrl": siteConfig.siteUrl
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "do-auditlog",
      "description": siteConfig.description,
      "url": siteConfig.siteUrl,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Go",
      "programmingLanguage": "Go",
      "license": "https://opensource.org/licenses/MIT",
      "author": {
        "@type": "Person",
        "name": "LarsArtmann",
        "url": siteConfig.author.url
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
